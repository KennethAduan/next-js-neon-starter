# Database: local SQLite (prisma/dev.db), DATABASE_URL is unused until
# `bun run strip-to-starter --apply` switches back to Neon PostgreSQL.
# Neon: use the pooled URL for normal application requests.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full"

# App
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
UNLOCK_PASSCODE="change-me"
NEXT_PUBLIC_ENCRYPTION_KEY="change-me-to-a-long-random-string"

# Better Auth
BETTER_AUTH_SECRET="generate-a-long-random-secret-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# Cloudflare R2: server-only S3-compatible credentials
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"

# Email (optional until mail flows wired)
ELASTIC_MAIL_DOMAIN=""
ELASTIC_MAIL_API_KEY=""
ELASTIC_MAIL_API_URL=""
