{
  "name": "next-js-neon-starter",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "doctor": "react-doctor",
    "fallow": "fallow --fail-on-issues --summary",
    "fallow:report": "fallow",
    "graphify": "graphify update",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@base-ui/react": "1.7.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tabler/icons-react": "3.46.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-table": "9.1.2",
    "@types/crypto-js": "4.2.2",
    "axios": "^1.19.0",
    "better-auth": "^1.6.29",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "crypto-js": "4.2.0",
    "jotai": "2.20.2",
    "nanoid": "^6.0.1",
    "next": "16.3.1",
    "next-safe-action": "8.6.0",
    "next-themes": "0.4.6",
    "nextjs-toploader": "3.9.17",
    "nuqs": "2.9.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "shadcn": "4.18.0",
    "sileo": "0.1.5",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "dotenv": "^17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "fallow": "3.16.0",
    "husky": "9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "postcss-load-config": "6.0.1",
    "prettier": "3.9.6",
    "prisma": "^7.9.1",
    "react-doctor": "0.9.12",
    "typescript": "6.0.2"
  }
}
