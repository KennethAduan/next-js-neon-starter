#!/usr/bin/env sh
set -e

zero="0000000000000000000000000000000000000000"
repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

require_local_tool() {
  tool_path="node_modules/.bin/$1"

  if [ ! -x "$tool_path" ]; then
    printf '%s\n' "Missing local $1. Run bun install."
    exit 1
  fi
}

run_changed_checks() {
  base="$1"
  ./node_modules/.bin/react-doctor --verbose --scope changed --base "$base" --no-score
  ./node_modules/.bin/fallow audit --summary --changed-since "$base"
}

default_base_branch() {
  if git rev-parse --verify origin/main >/dev/null 2>&1; then
    printf '%s\n' "origin/main"
  elif git rev-parse --verify origin/master >/dev/null 2>&1; then
    printf '%s\n' "origin/master"
  elif git rev-parse --verify main >/dev/null 2>&1; then
    printf '%s\n' "main"
  else
    printf '%s\n' "master"
  fi
}

resolve_push_base() {
  remote_sha="$1"
  if [ "$remote_sha" = "$zero" ] || [ -z "$remote_sha" ]; then
    default_base_branch
    return
  fi

  printf '%s\n' "$remote_sha"
}

require_local_tool react-doctor
require_local_tool fallow

ran=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi

  base=$(resolve_push_base "$remote_sha")
  run_changed_checks "$base"
  ran=1
done

if [ "$ran" -eq 0 ]; then
  if git rev-parse --verify "@{upstream}" >/dev/null 2>&1; then
    base=$(git merge-base HEAD "@{upstream}")
  else
    base=$(default_base_branch)
  fi

  run_changed_checks "$base"
fi
